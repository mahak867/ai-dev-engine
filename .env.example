# Required — get from home.qwencloud.com/api-keys
QWEN_API_KEY=your_qwen_api_key_here

# Optional fallback provider
GROQ_API_KEY=your_groq_api_key_here

# ── Server security (see README "Security model") ───────────────────────────
# Required if APEX_HOST is not loopback. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APEX_API_TOKEN=
APEX_HOST=127.0.0.1
APEX_PORT=8000
# APEX_ALLOWED_HOSTS=localhost,127.0.0.1,apex.example.com
# APEX_ALLOWED_ORIGINS=http://localhost:8000,https://apex.example.com
APEX_MAX_CONCURRENT_JOBS=2
APEX_MAX_TASK_CHARS=500

# Let the engine install deps / run / deploy generated code on this machine.
APEX_ALLOW_EXECUTION=0
